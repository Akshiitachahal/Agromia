// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ─────────────────────────────────────────────
// PRODUCT CATEGORIES
// ─────────────────────────────────────────────

model ProductCategory {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  imageUrl     String?
  color        String?                   // subtle category accent color
  displayOrder Int                       @default(0)
  isActive     Boolean                   @default(true)
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model CategoryTranslation {
  id          String          @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?         @db.Text
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id             String               @id @default(cuid())
  slug           String               @unique
  categoryId     String
  primaryImageUrl String?
  has3dModel     Boolean              @default(false)
  isPublished    Boolean              @default(false)
  isFeatured     Boolean              @default(false)
  displayOrder   Int                  @default(0)
  category       ProductCategory      @relation(fields: [categoryId], references: [id])
  translations   ProductTranslation[]
  images         ProductImage[]
  assets3d       Product3DAsset[]
  brochures      ProductBrochure[]
  cropMappings   CropProductMapping[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String
  locale          Locale
  name            String
  shortDescription String? @db.Text
  composition     String? @db.Text
  formulation     String?
  benefits        String? @db.Text  // JSON array stored as text
  targetCrops     String? @db.Text  // JSON array stored as text
  targetPests     String? @db.Text  // JSON array stored as text
  dosage          String? @db.Text
  applicationMethod String? @db.Text
  technicalInfo   String? @db.Text
  packaging       String?
  recommendation  String? @db.Text
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  altText     String?
  displayOrder Int     @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product3DAsset {
  id        String   @id @default(cuid())
  productId String
  url       String
  format    String   @default("glb")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductBrochure {
  id        String   @id @default(cuid())
  productId String
  url       String
  label     String?
  locale    Locale   @default(EN)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CROPS & PROBLEMS (Crop Finder)
// ─────────────────────────────────────────────

model Crop {
  id           String               @id @default(cuid())
  slug         String               @unique
  imageUrl     String?
  isActive     Boolean              @default(true)
  displayOrder Int                  @default(0)
  translations CropTranslation[]
  problems     Problem[]            @relation("CropProblems")
  mappings     CropProductMapping[]
  createdAt    DateTime             @default(now())
}

model CropTranslation {
  id      String @id @default(cuid())
  cropId  String
  locale  Locale
  name    String
  crop    Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, locale])
}

model Problem {
  id           String              @id @default(cuid())
  slug         String              @unique
  isActive     Boolean             @default(true)
  displayOrder Int                 @default(0)
  crops        Crop[]              @relation("CropProblems")
  translations ProblemTranslation[]
  mappings     CropProductMapping[]
  createdAt    DateTime            @default(now())
}

model ProblemTranslation {
  id        String  @id @default(cuid())
  problemId String
  locale    Locale
  name      String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, locale])
}

model CropProductMapping {
  id        String  @id @default(cuid())
  cropId    String
  problemId String?
  productId String
  crop      Crop    @relation(fields: [cropId], references: [id], onDelete: Cascade)
  problem   Problem? @relation(fields: [problemId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cropId, problemId, productId])
}

// ─────────────────────────────────────────────
// DIRECTORS
// ─────────────────────────────────────────────

model Director {
  id           String               @id @default(cuid())
  imageUrl     String?
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  translations DirectorTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model DirectorTranslation {
  id          String   @id @default(cuid())
  directorId  String
  locale      Locale
  name        String
  designation String
  bio         String?  @db.Text
  director    Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@unique([directorId, locale])
}

// ─────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model SocialLinks {
  id        String  @id @default(cuid())
  platform  String  @unique
  url       String?
  isActive  Boolean @default(true)
}

// ─────────────────────────────────────────────
// HOMEPAGE CONTENT
// ─────────────────────────────────────────────

model HeroContent {
  id          String @id @default(cuid())
  locale      Locale @unique
  tagline     String
  subtitle    String?
  ctaPrimary  String
  ctaSecondary String
  videoUrl    String?
  posterUrl   String?
  updatedAt   DateTime @updatedAt
}

model AboutContent {
  id        String @id @default(cuid())
  locale    Locale @unique
  heading   String
  statement String @db.Text
  body      String @db.Text
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model WhyAgromiaItem {
  id           String                    @id @default(cuid())
  icon         String?
  displayOrder Int                       @default(0)
  isActive     Boolean                   @default(true)
  translations WhyAgromiaTranslation[]
}

model WhyAgromiaTranslation {
  id          String         @id @default(cuid())
  itemId      String
  locale      Locale
  title       String
  description String         @db.Text
  item        WhyAgromiaItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
}

model QualityStep {
  id           String               @id @default(cuid())
  imageUrl     String?
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  translations QualityStepTranslation[]
}

model QualityStepTranslation {
  id          String      @id @default(cuid())
  stepId      String
  locale      Locale
  title       String
  description String?     @db.Text
  step        QualityStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, locale])
}

// ─────────────────────────────────────────────
// LEGAL PAGES
// ─────────────────────────────────────────────

model LegalPage {
  id        String @id @default(cuid())
  slug      String
  locale    Locale
  title     String
  content   String @db.Text
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

// ─────────────────────────────────────────────
// ENQUIRIES
// ─────────────────────────────────────────────

model ContactEnquiry {
  id          String   @id @default(cuid())
  name        String
  mobile      String?
  email       String?
  product     String?
  subject     String?
  message     String   @db.Text
  ipAddress   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Locale {
  EN
  HI
  HAR
}
